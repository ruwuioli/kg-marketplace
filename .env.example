# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kgm:kgm@localhost:5432/kgm_dev"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── File Storage (Cloudflare R2 or MinIO) ─────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kgm-assets"
R2_PUBLIC_URL="https://assets.kgmarket.kg"

# ── Search ────────────────────────────────────────────────────────────────────
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="masterKey"

# ── Payments ──────────────────────────────────────────────────────────────────
MBANK_API_KEY=""
MBANK_SECRET_KEY=""
ODENGI_API_KEY=""
ODENGI_SECRET_KEY=""
ELCAT_MERCHANT_ID=""
ELCAT_SECRET_KEY=""

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@kgmarket.kg"

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
API_PORT="3001"

# ── MinIO (local S3-compatible) ───────────────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="kgm-media"
MINIO_PUBLIC_URL="http://localhost:9000/kgm-media"

# ── Web BFF → API ─────────────────────────────────────────────────────────────
API_INTERNAL_URL="http://localhost:3001/api/v1"
